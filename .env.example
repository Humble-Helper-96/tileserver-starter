# Copy this file to .env and change the values if you need to.

# Host port for the tile server web interface and tile endpoints.
TILESERVER_PORT=8080

# Server configuration file.
# config.json = all four styles. It needs all three mbtiles files.
# config-basic.json = osm and overlay only. It needs only basemap.mbtiles.
TILESERVER_CONFIG=config.json
